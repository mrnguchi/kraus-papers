# Private server configuration: never put this file's populated copy in public/.
APP_ORIGIN=https://krauspapersgmbh.com
MAIL_TRANSPORT=graph
MAIL_GRAPH_TENANT_ID=your-directory-tenant-id
MAIL_GRAPH_CLIENT_ID=your-application-client-id
MAIL_GRAPH_CERT_THUMBPRINT_SHA256=your-sha256-certificate-fingerprint-without-colons
MAIL_GRAPH_PRIVATE_KEY_BASE64=your-base64-encoded-private-pem-file
MAIL_FROM_ADDRESS=info@krauspapersgmbh.com
MAIL_FROM_NAME="Kraus Papers"
# Local production-build testing only (npm start); npm run dev needs no setting.
# CONTACT_STORE=memory
# Netlify automatically uses shared Blobs storage and its trusted client-IP header.
# Do not add Netlify access tokens or NEXT_PUBLIC_ mail credentials.
